{
 "podracers": [
  {
   "id": "anakin",
   "name": "Anakin",
   "blurb": "On-policy and fused: rollout and update compiled into one program, run in one worker."
  },
  {
   "id": "sebulba",
   "name": "Sebulba",
   "blurb": "Actor and learner in two workers. Parameters cross by message with a fixed one-update lag, as in Cleanba."
  },
  {
   "id": "quadinaros",
   "name": "Quadinaros",
   "blurb": "Offline: learns from a bundled dataset and never steps the environment while training."
  }
 ],
 "pilots": [
  {
   "id": "ppo",
   "name": "PPO",
   "blurb": "Proximal policy optimisation: clipped policy gradient with a learned value baseline."
  },
  {
   "id": "pqn",
   "name": "PQN",
   "blurb": "Parallel Q-network: Q(lambda) on fresh rollouts with LayerNorm, no replay buffer, no target network."
  },
  {
   "id": "dqn",
   "name": "DQN",
   "blurb": "Deep Q-network: epsilon-greedy acting, a replay buffer and a Polyak-averaged target network."
  },
  {
   "id": "bc",
   "name": "BC",
   "blurb": "Behaviour cloning: maximum likelihood on the actions of a trained policy."
  },
  {
   "id": "iql",
   "name": "IQL",
   "blurb": "Implicit Q-learning: expectile value regression and advantage-weighted cloning."
  }
 ],
 "tracks": [
