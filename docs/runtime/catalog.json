{
 "podracers": [
  {
   "id": "anakin",
   "name": "Anakin",
   "blurb": "Rollout and update compile into one on-policy program that runs in one worker."
  },
  {
   "id": "sebulba",
   "name": "Sebulba",
   "blurb": "Actor and learner in two workers. Parameters cross by message with a fixed one-update lag, as in Cleanba."
  },
  {
   "id": "quadinaros",
   "name": "Quadinaros",
   "blurb": "Learns offline from a bundled dataset and never steps the environment while training."
  }
 ],
 "pilots": [
  {
   "id": "ppo",
   "name": "PPO",
   "blurb": "Proximal policy optimization clips the policy gradient and learns a value baseline."
  },
  {
   "id": "pqn",
   "name": "PQN",
   "blurb": "Parallel Q-network learns Q(\u03bb) on fresh rollouts with LayerNorm, without a replay buffer or a target network."
  },
  {
   "id": "dqn",
   "name": "DQN",
   "blurb": "Deep Q-network acts \u03b5-greedily and learns from a replay buffer against a Polyak-averaged target network."
  },
  {
   "id": "bc",
   "name": "BC",
   "blurb": "Behavior cloning maximizes the likelihood of a trained policy's actions."
  },
  {
   "id": "iql",
   "name": "IQL",
   "blurb": "Implicit Q-learning regresses values to an expectile and clones actions weighted by their advantage."
  }
 ],
